# Environment variables for FoodScan
# Copy this file to .env and fill in your actual values.
# WARNING: DO NOT COMMIT YOUR ACTUAL .env FILE TO GIT!

# Django Core Settings
DJANGO_SECRET_KEY='YOUR_DJANGO_SECRET_KEY' # Generate a strong, unique key (e.g., using python -c 'import secrets; print(secrets.token_hex())')
DJANGO_DEBUG=True # Set to False in production
DJANGO_ALLOWED_HOSTS='127.0.0.1,localhost' # Add your production domain(s) here, separated by commas
# DATABASE_URL=sqlite:///db.sqlite3 # Default. Uncomment and configure for PostgreSQL/MySQL if needed.

# Third-Party Services
OCR_SPACE_API_KEY='YOUR_OCR_SPACE_API_KEY' # Get from https://ocr.space/
OCR_SPACE_API_URL='https://api.ocr.space/parse/image'
AI_ANALYZER_API_KEY='YOUR_AI_ANALYZER_API_KEY' # Get from your chosen AI service provider (e.g., Google AI Studio for Gemini)

# Auth0 Settings (Get from your Auth0 Application settings)
AUTH0_CLIENT_ID='YOUR_AUTH0_CLIENT_ID'
AUTH0_CLIENT_SECRET='YOUR_AUTH0_CLIENT_SECRET'
AUTH0_DOMAIN='YOUR_AUTH0_DOMAIN' # e.g., your-tenant.us.auth0.com
DJANGO_AUTH0_CALLBACK_URL='http://localhost:8000/callback' # Update with your local dev or production URL
DJANGO_AUTH0_AUDIENCE='YOUR_AUTH0_API_IDENTIFIER' # The Identifier for your Auth0 API (e.g., https://food-scan-api) 